{
    "app": {
        "name": "MedScan AI",
        "version": "1.0.0",
        "api_base_url": "http://127.0.0.1:8000"
    },
    "clinical_ranges": {
        "blood_sugar_fasting": {"min": 70, "max": 100, "unit": "mg/dL"},
