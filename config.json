        "blood_pressure_dia": {"min": 60, "max": 80, "unit": "mmHg"},
        "cholesterol": {"min": 125, "max": 200, "unit": "mg/dL"},
        "hemoglobin": {"min": 12.0, "max": 16.5, "unit": "g/dL"},
        "wbc": {"min": 4000, "max": 11000, "unit": "/cumm"},
        "platelet": {"min": 1.5, "max": 4.5, "unit": "lakh/cumm"},
        "creatinine": {"min": 0.6, "max": 1.3, "unit": "mg/dL"},
        "bmi": {"min": 18.5, "max": 24.9, "unit": "kg/m²"}
